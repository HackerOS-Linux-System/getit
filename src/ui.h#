mod util

;; ── ui.h# ─ colours, symbols and one-line message helpers ────────────────────
;;
;; Colours are switched off when NO_COLOR / GETIT_NO_COLOR is set, when TERM is
;; "dumb", or when stdout is not a terminal (so `getit ... | tee log` stays clean).
;; `init` decides that once at start-up and remembers it in the environment,
;; because every paint() would otherwise have to fork `test -t 1` again.

pub fn init(quiet: bool) is
    if quiet is env_set("GETIT_QUIET", "1") end
    if env_get("NO_COLOR") != "" || env_get("TERM") == "dumb" is
        env_set("GETIT_NO_COLOR", "1")
    else if env_get("GETIT_NO_COLOR") == "" && !util::tty_out() is
        env_set("GETIT_NO_COLOR", "1")
    end
end

pub fn quiet() -> bool is
    return env_get("GETIT_QUIET") == "1"
end

fn paint(code: string, s: string) -> string is
    if env_get("GETIT_NO_COLOR") != "" is return s end
    return "\x1b[" + code + "m" + s + "\x1b[0m"
end

pub fn bold(s: string)   -> string is return paint("1", s)            end
pub fn dim(s: string)    -> string is return paint("2", s)            end
pub fn red(s: string)    -> string is return paint("1;31", s)         end
pub fn green(s: string)  -> string is return paint("1;38;5;82", s)   end
pub fn yellow(s: string) -> string is return paint("1;38;5;208", s)  end
pub fn cyan(s: string)   -> string is return paint("1;38;5;39", s)   end
pub fn teal(s: string)   -> string is return paint("1;38;5;86", s)   end

;; ── messages (everything but fail/warn is hidden by --quiet) ────────────────

pub fn title(msg: string) is
    if !quiet() is write(teal(msg)) end
end

pub fn step(msg: string) is
    if !quiet() is write(" " + cyan("→") + " " + msg) end
end

pub fn ok(msg: string) is
    if !quiet() is write(" " + green("✓") + " " + msg) end
end

pub fn note(msg: string) is
    if !quiet() is write("   " + dim(msg)) end
end

pub fn line(msg: string) is
    if !quiet() is write(msg) end
end

pub fn blank() is
    if !quiet() is write("") end
end

;; label/value row, label padded to 8 columns (keep labels ASCII)
pub fn kv(label: string, value: string) is
    if !quiet() is write("   " + dim(string_pad_right(label, 8)) + " " + value) end
end

pub fn fail(msg: string) is
    write(" " + red("✗ Błąd:") + " " + msg)
end

pub fn warn(msg: string) is
    write(" " + yellow("! Uwaga:") + " " + msg)
end

;; a tip printed under an error – always shown, it is the useful part
pub fn hint(msg: string) is
    write("   " + dim("↳ " + msg))
end
