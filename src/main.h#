use "std -> fs"   from "fs"
use "std -> str"  from "str"
use "std -> json" from "json"

;; ── ANSI style constants ──────────────────────────────────────────────────────

pub let TITLE   : string = "\x1b[1;38;5;86m"
pub let SUCCESS : string = "\x1b[1;38;5;82m"
pub let ERROR   : string = "\x1b[1;31m"
pub let WARNING : string = "\x1b[1;38;5;208m"
pub let INFO    : string = "\x1b[1;38;5;39m"
pub let RESET   : string = "\x1b[0m"

fn styled(s: string, style: string) -> string is
    return style + s + RESET
end

;; ── Entry point ───────────────────────────────────────────────────────────────

fn main() is
    let args = env::args()

    if args.len() < 2 is
        print_usage()
        return
    end

    let subcmd = args[1]

    if subcmd == "file" is
        handle_file(args)
    elsif subcmd == "repo" is
        handle_repo(args)
    elsif subcmd == "dir" is
        handle_dir(args)
    elsif subcmd == "-h" || subcmd == "--help" is
        print_usage()
    else
        write(styled("Błąd: Nieznana komenda '" + subcmd + "'", ERROR))
        print_usage()
    end
end

fn print_usage() is
    write(styled("getit • Uniwersalne narzędzie do pobierania i zarządzania", TITLE))
    write("")
    write("Użycie:")
    write("  " + styled("getit file <link> [flagi]", INFO) + "         - Pobierz pojedynczy plik (jak curl/wget)")
    write("  " + styled("getit repo <link.git> [flagi]", INFO) + "     - Operacje git (np. -clone, -push)")
    write("  " + styled("getit dir <katalog_github> [flagi]", INFO) + " - Pobierz folder z GitHub")
    write("")
    write("Flagi ogólne: -h (pomoc)")
end

;; ── Utilities ─────────────────────────────────────────────────────────────────

fn curl_exists() -> bool is
    let result = proc::run_cmd("which curl", 3)
    return result.exit_code == 0
end

fn check_curl() is
    if !curl_exists() is
        write(styled("Błąd: curl nie jest zainstalowany. Zainstaluj curl i spróbuj ponownie.", ERROR))
        proc::exit(1)
    end
end

fn basename(path: string) -> string is
    ;; Extract filename from URL or path
    let no_query = if path.contains("?") is
        str::split(path, "?")[0]
    else
        path
    end
    let parts = str::split(no_query, "/")
    if parts.len() == 0 is return path end
    let last = parts[parts.len() - 1]
    if last == "" && parts.len() > 1 is return parts[parts.len() - 2] end
    return last
end

fn human_bytes(n: int) -> string is
    if n < 1024 is return conv::int_to_str(n) + " B" end
    if n < 1048576 is return conv::int_to_str(n / 1024) + " KB" end
    if n < 1073741824 is return conv::int_to_str(n / 1048576) + " MB" end
    return conv::int_to_str(n / 1073741824) + " GB"
end

;; ── handle_file ───────────────────────────────────────────────────────────────

fn handle_file(args: [string]) is
    if args.len() < 3 is
        write(styled("Błąd: Podaj link do pliku", ERROR))
        write("Użycie: getit file <URL> [-o FILENAME]")
        proc::exit(1)
    end

    check_curl()

    let url = args[2]
    let mut filename = basename(url)
    if filename == "" is filename = "output" end

    ;; Check for -o flag
    let mut i: int = 3
    while i < args.len() is
        if args[i] == "-o" && i + 1 < args.len() is
            filename = args[i + 1]
            i += 2
            continue
        end
        if args[i] == "-h" is
            write("Użycie: getit file <URL> [-o NAZWA_PLIKU]")
            return
        end
        i += 1
    end

    write(styled("getit file • Pobieranie pliku", TITLE))
    write(" URL: " + url)
    write(" Zapisywanie jako: " + filename)
    write("")

    ;; Get file size first (HEAD request)
    let head_cmd = "curl -sI -L --max-time 10 '" + url + "' 2>/dev/null"
    let headers = proc::run_cmd(head_cmd, 15).stdout
    let content_length = extract_content_length(headers)

    if content_length > 0 is
        write(styled("Rozmiar: " + human_bytes(content_length), INFO))
    end

    ;; Download with progress bar
    write(styled("Pobieranie...", INFO))
    let cmd = "curl -L --progress-bar --max-time 3600 -o '" + filename + "' '" + url + "' 2>&1"
    let result = proc::run_cmd_live(cmd, 3600)

    if result.exit_code != 0 is
        write(styled("Błąd podczas pobierania:", ERROR))
        write(result.stderr)
        proc::exit(1)
    end

    if !fs::exists(filename) is
        write(styled("Błąd: Plik nie został zapisany.", ERROR))
        proc::exit(1)
    end

    let size = fs::size(filename)
    write("")
    write(styled("Gotowe! Pobrano plik: " + filename + " (" + human_bytes(size) + ")", SUCCESS))
end

fn extract_content_length(headers: string) -> int is
    let lines = str::split(headers, "\n")
    let mut i: int = 0
    while i < lines.len() is
        let line = str::to_lower(str::trim(lines[i]))
        if line.starts_with("content-length:") is
            let parts = str::split(lines[i], ":")
            if parts.len() >= 2 is
                return conv::str_to_int(str::trim(parts[1]))
            end
        end
        i += 1
    end
    return 0
end

;; ── handle_repo ───────────────────────────────────────────────────────────────

fn handle_repo(args: [string]) is
    if args.len() < 3 is
        write(styled("Błąd: Podaj link do repozytorium", ERROR))
        write("Użycie: getit repo <URL.git> -clone|-push")
        proc::exit(1)
    end

    let link = args[2]
    let mut do_clone: bool = false
    let mut do_push:  bool = false

    let mut i: int = 3
    while i < args.len() is
        if args[i] == "-clone" is do_clone = true end
        if args[i] == "-push"  is do_push  = true end
        if args[i] == "-h" is
            write("Flagi: -clone (klonuj), -push (push do remote)")
            return
        end
        i += 1
    end

    write(styled("getit repo • Operacje Git", TITLE))
    write(" Repo: " + link)
    write("")

    if do_clone is
        write(styled("Klonowanie repozytorium...", INFO))
        let result = proc::run_cmd_live("git clone '" + link + "' 2>&1", 600)
        if result.exit_code != 0 is
            write(styled("Błąd podczas klonowania: " + result.stderr, ERROR))
            proc::exit(1)
        end
        write(styled("Repozytorium sklonowane pomyślnie", SUCCESS))
    elsif do_push is
        write(styled("Pushowanie zmian...", INFO))
        proc::run_cmd("git remote add origin '" + link + "' 2>/dev/null", 10)
        let result = proc::run_cmd_live("git push origin main 2>&1", 120)
        if result.exit_code != 0 is
            write(styled("Błąd podczas push: " + result.stderr, ERROR))
            proc::exit(1)
        end
        write(styled("Zmiany wypchnięte pomyślnie", SUCCESS))
    else
        write(styled("Błąd: Podaj flagę, np. -clone lub -push", ERROR))
        proc::exit(1)
    end
end

;; ── handle_dir ────────────────────────────────────────────────────────────────

fn handle_dir(args: [string]) is
    if args.len() < 3 is
        write(styled("Błąd: Podaj URL folderu GitHub", ERROR))
        write("Użycie: getit dir <github.com/user/repo/tree/branch/folder>")
        proc::exit(1)
    end

    check_curl()

    let raw_url = args[2]

    let mut i: int = 3
    while i < args.len() is
        if args[i] == "-h" is
            write("Użycie: getit dir <URL_GITHUB>")
            write("Przykłady:")
            write("  getit dir https://github.com/user/repo/tree/main/src")
            write("  getit dir github.com/user/repo")
            return
        end
        i += 1
    end

    let github = parse_github_url(raw_url)

    write(styled("getit dir • Pobieranie folderu z GitHub", TITLE))
    write(" " + github.user + "/" + github.repo + " • " + github.branch)
    if github.folder != "" is
        write(" Folder: " + github.folder)
    end
    write("")

    ;; Check if we should use sparse checkout (folder from large repo)
    let tar_url = "https://github.com/" + github.user + "/" + github.repo +
                  "/archive/refs/heads/" + github.branch + ".tar.gz"

    ;; Load etag cache for "is this already up to date?" check
    let cache = load_cache()
    let cache_key = github.user + "/" + github.repo + "/" + github.branch + "/" + github.folder
    let cached_etag = json::get_str(cache, cache_key)

    write(styled("Sprawdzanie repozytorium...", INFO))

    ;; HEAD request to get ETag and Content-Length
    let mut head_flags = "curl -sI -L --max-time 15"
    if cached_etag != "" is
        head_flags = head_flags + " -H 'If-None-Match: " + cached_etag + "'"
    end
    let head_result = proc::run_cmd(head_flags + " '" + tar_url + "' 2>/dev/null", 20)
    let head_headers = head_result.stdout

    let http_status = extract_http_status(head_headers)
    let content_length = extract_content_length(head_headers)
    let new_etag = extract_etag(head_headers)

    if http_status == 304 is
        write(styled("Folder jest aktualny. Brak zmian.", SUCCESS))
        return
    end

    if http_status != 200 is
        write(styled("Błąd: Nie można uzyskać dostępu (status " + conv::int_to_str(http_status) + ")", ERROR))
        proc::exit(1)
    end

    ;; Large archive warning (>2 GB)
    let two_gb: int = 2147483648
    if content_length > two_gb is
        let size_mb = content_length / 1048576
        write(styled("Ostrzeżenie: Archiwum jest duże (" + conv::int_to_str(size_mb) + " MB).", WARNING))
        write("Kontynuować? (y/n): ")
        let answer = str::trim(env::read_line())
        if str::to_lower(answer) != "y" is
            write("Przerwano.")
            return
        end
    end

    ;; Decide strategy: sparse-checkout for large repos with a specific folder
    let five_hundred_mb: int = 524288000
    let use_sparse = github.folder != "" && content_length > five_hundred_mb

    let mut count: int = 0
    let target_dir = last_path_segment(github.folder)

    if use_sparse is
        write(styled("Archiwum jest duże, używam git sparse-checkout...", INFO))
        count = download_with_sparse(github.user, github.repo, github.branch, github.folder)
    else
        write(styled("Pobieranie archiwum (" + human_bytes(content_length) + ")...", INFO))

        let tmp_tar = "/tmp/getit_" + github.repo + "_" + github.branch + ".tar.gz"
        let tmp_dir = "/tmp/getit_extract_" + conv::int_to_str(math::random_int(100000, 999999))

        let dl_cmd = "curl -L --progress-bar --max-time 3600 -o '" + tmp_tar + "' '" + tar_url + "' 2>&1"
        let dl_result = proc::run_cmd_live(dl_cmd, 3600)

        if dl_result.exit_code != 0 is
            write(styled("Błąd pobierania: " + dl_result.stderr, ERROR))
            proc::exit(1)
        end

        write(styled("Rozpakowywanie plików...", INFO))

        ;; Extract with tar, stripping the top-level directory
        fs::mkdir(tmp_dir)
        let strip = calc_strip(github.repo, github.branch, github.folder)
        let tar_cmd = "tar -xzf '" + tmp_tar + "' --strip-components=" +
                      conv::int_to_str(strip) + " -C '" + tmp_dir + "' 2>&1"
        let tar_result = proc::run_cmd(tar_cmd, 300)

        if tar_result.exit_code != 0 is
            write(styled("Błąd rozpakowywania: " + tar_result.stderr, ERROR))
            fs::remove(tmp_tar)
            proc::exit(1)
        end

        ;; Atomic rename: tmp_dir → target_dir
        if github.folder != "" is
            ;; We extracted the specific subfolder — move it out
            let extracted_sub = tmp_dir + "/" + last_path_segment(github.folder)
            if fs::exists(extracted_sub) is
                atomic_rename(extracted_sub, target_dir)
                fs::remove_dir(tmp_dir)
            else
                atomic_rename(tmp_dir, target_dir)
            end
        else
            atomic_rename(tmp_dir, target_dir)
        end

        count = count_entries(target_dir)
        fs::remove(tmp_tar)
    end

    write(styled("\nGotowe! Pobrano " + conv::int_to_str(count) + " plików/folderów", SUCCESS))
    write(" → " + styled("./" + target_dir, SUCCESS))

    ;; Save etag for next run
    if new_etag != "" is
        let updated_cache = json::set_str(cache, cache_key, new_etag)
        save_cache(updated_cache)
    end
end

;; ── GitHub URL parser ─────────────────────────────────────────────────────────

struct GithubRef is
    pub user:   string
    pub repo:   string
    pub branch: string
    pub folder: string
end

fn parse_github_url(raw: string) -> GithubRef is
    let mut url = raw
    if url.starts_with("https://github.com/") is
        url = url[19..url.len()]
    elsif url.starts_with("http://github.com/") is
        url = url[18..url.len()]
    elsif url.starts_with("github.com/") is
        url = url[11..url.len()]
    end
    ;; Remove trailing slash
    if url.ends_with("/") is url = url[0..url.len()-1] end

    let parts = str::split(url, "/")

    if parts.len() < 2 is
        write(styled("Błąd: Nieprawidłowy URL GitHub: " + raw, ERROR))
        proc::exit(1)
    end

    let user = parts[0]
    let repo = parts[1]
    let mut branch = "main"
    let mut folder = ""
    let mut i: int = 2

    ;; /tree/branchname/...
    if i < parts.len() && parts[i] == "tree" && i + 1 < parts.len() is
        branch = parts[i + 1]
        i += 2
    end

    ;; remaining parts = folder path
    if i < parts.len() is
        let mut folder_parts: [string] = []
        while i < parts.len() is
            folder_parts.push(parts[i])
            i += 1
        end
        folder = iter::join(folder_parts, "/")
    end

    return GithubRef { user: user, repo: repo, branch: branch, folder: folder }
end

;; ── Sparse checkout ───────────────────────────────────────────────────────────

fn download_with_sparse(user: string, repo: string, branch: string, folder: string) -> int is
    let tmp_dir = "/tmp/getit_sparse_" + conv::int_to_str(math::random_int(100000, 999999))
    let git_url = "https://github.com/" + user + "/" + repo + ".git"

    let cmds: [string] = [
        "git clone -b " + branch + " --filter=blob:none --no-checkout '" + git_url + "' '" + tmp_dir + "' 2>&1",
        "git -C '" + tmp_dir + "' sparse-checkout init --cone 2>&1",
        "git -C '" + tmp_dir + "' sparse-checkout set '" + folder + "' 2>&1",
        "git -C '" + tmp_dir + "' checkout " + branch + " 2>&1",
    ]

    let mut i: int = 0
    while i < cmds.len() is
        let result = proc::run_cmd_live(cmds[i], 300)
        if result.exit_code != 0 is
            write(styled("Błąd sparse-checkout: " + result.stderr, ERROR))
            fs::remove_dir(tmp_dir)
            proc::exit(1)
        end
        i += 1
    end

    ;; Remove .git directory (not needed)
    fs::remove_dir(tmp_dir + "/.git")

    let src_dir = tmp_dir + "/" + folder
    let target  = last_path_segment(folder)

    atomic_rename(src_dir, target)
    fs::remove_dir(tmp_dir)

    return count_entries(target)
end

;; ── Helper functions ──────────────────────────────────────────────────────────

fn calc_strip(repo: string, branch: string, folder: string) -> int is
    ;; tar strips repo-branch/ prefix (1 level) + folder depth
    if folder == "" is return 1 end
    let depth = str::count(folder, "/")
    return 1 + depth
end

fn last_path_segment(path: string) -> string is
    if path == "" is return "." end
    let mut p = path
    if p.ends_with("/") is p = p[0..p.len()-1] end
    let parts = str::split(p, "/")
    return parts[parts.len() - 1]
end

fn atomic_rename(src: string, dst: string) is
    ;; If destination exists, move it to a .old backup first
    if fs::exists(dst) is
        let old = dst + ".old"
        fs::rename(dst, old)
        let result = proc::run_cmd("mv '" + src + "' '" + dst + "' 2>&1", 30)
        if result.exit_code == 0 is
            fs::remove_dir(old)
        else
            ;; Rollback
            fs::rename(old, dst)
            write(styled("Błąd: Nie można przenieść plików do " + dst, ERROR))
            proc::exit(1)
        end
    else
        let result = proc::run_cmd("mv '" + src + "' '" + dst + "' 2>&1", 30)
        if result.exit_code != 0 is
            write(styled("Błąd rename: " + result.stderr, ERROR))
            proc::exit(1)
        end
    end
end

fn count_entries(dir: string) -> int is
    if !fs::exists(dir) is return 0 end
    let result = proc::run_cmd("find '" + dir + "' | wc -l 2>/dev/null", 30)
    if result.exit_code != 0 is return 0 end
    return conv::str_to_int(str::trim(result.stdout))
end

fn extract_http_status(headers: string) -> int is
    ;; Parse "HTTP/1.1 200 OK" or "HTTP/2 304"
    let lines = str::split(headers, "\n")
    if lines.len() == 0 is return 0 end
    let first = str::trim(lines[0])
    let parts = str::split(first, " ")
    if parts.len() < 2 is return 0 end
    return conv::str_to_int(parts[1])
end

fn extract_etag(headers: string) -> string is
    let lines = str::split(headers, "\n")
    let mut i: int = 0
    while i < lines.len() is
        let line = str::to_lower(str::trim(lines[i]))
        if line.starts_with("etag:") is
            let parts = str::split(lines[i], ":")
            if parts.len() >= 2 is
                return str::trim(parts[1])
            end
        end
        i += 1
    end
    return ""
end

;; ── ETag cache (~/.config/getit/cache.json) ───────────────────────────────────

fn cache_path() -> string is
    let home = env::get("HOME")
    return home + "/.config/getit/cache.json"
end

fn load_cache() -> json is
    let path = cache_path()
    if !fs::exists(path) is return json::empty_object() end
    let content = fs::read(path)
    if content == "" is return json::empty_object() end
    return json::parse(content)
end

fn save_cache(cache: json) is
    let path = cache_path()
    fs::mkdir(env::get("HOME") + "/.config/getit")
    fs::write(path, json::stringify_pretty(cache))
end
