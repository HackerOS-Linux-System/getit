mod util
mod ui
mod opts
mod link
mod help
mod cmd_file
mod cmd_dir
mod cmd_repo
mod cmd_misc

;; ── main.h# ─ argument parsing and dispatch only ─────────────────────────────
;;
;; getit <link>        – guesses file / folder / repository from the link
;; getit file|dir|repo – explicit, but a wrong choice is corrected automatically
;;                       (`file` on a folder link behaves like `dir` and vice versa)

extern static [c] is
    fn exit(code: int)
end

fn is_command(c: string) -> bool is
    return c == "file" || c == "dir" || c == "repo" || c == "get" || c == "info" || c == "doctor"
end

fn looks_like_link(s: string) -> bool is
    return string_contains(s, "/") || string_contains(s, "@")
end

fn suggest(c: string) -> string is
    let names: [string] = ["file", "dir", "repo", "info", "doctor"]
    let mut i: int = 0
    while i < array_len(names) is
        let n: string = names[i]
        if string_len(c) >= 2 && (string_starts_with(n, string_slice(c, 0, 2)) || string_starts_with(c, n)) is return n end
        i += 1
    end
    return ""
end

;; run `kind` (file | dir | repo) for the first link
fn dispatch(kind: string, o: opts::Opts) -> int is
    if kind == "file" is return cmd_file::run(o) end
    if kind == "dir" is return cmd_dir::run(o) end
    return cmd_repo::run(o)
end

fn guess(requested: string, o: opts::Opts) -> int is
    if array_len(o.oo_pos) == 0 is
        if requested == "" is
            help::usage()
            return 2
        end
        return dispatch(requested, o)
    end
    let urls: [string] = o.oo_pos
    let l: link::Link = link::settle(link::parse(urls[0]))
    if !l.lk_ok is
        ui::fail("Nie rozumiem adresu: " + urls[0])
        ui::hint("Przykład: getit https://github.com/user/repo/blob/main/plik  lub  getit user/repo")
        return 2
    end
    let actual: string = link::classify(l)
    if requested == "" is return dispatch(actual, o) end
    ;; `repo` is always honoured; file <-> dir are swapped when the link says so
    if requested == "repo" is return cmd_repo::run(o) end
    if requested == "file" && actual == "repo" is return dispatch("dir", o) end
    if requested != actual && actual != "repo" && array_len(o.oo_pos) == 1 is
        ui::note("Ten link wskazuje " + (if actual == "dir" then "folder" else "plik") + " – używam 'getit " + actual + "'.")
        return dispatch(actual, o)
    end
    return dispatch(requested, o)
end

fn main() is
    let args: [string] = env_args()
    let argc: int = array_len(args)
    if argc < 2 is
        help::usage()
        exit(0)
    end
    let cmd: string = args[1]
    ui::init(false)
    if cmd == "-h" || cmd == "--help" || cmd == "help" is
        help::show(if argc > 2 then args[2] else "")
        exit(0)
    end
    if cmd == "-V" || cmd == "--version" || cmd == "version" is
        help::version()
        exit(0)
    end

    let named: bool = is_command(cmd)
    let o: opts::Opts = opts::parse(args, if named then 2 else 1)
    ui::init(o.oo_quiet)
    if o.oo_bad != "" is
        ui::fail(o.oo_bad)
        ui::hint("Lista opcji: getit --help")
        exit(2)
    end
    if o.oo_help is
        help::show(if named then cmd else "")
        exit(0)
    end

    let mut rc: int = 0
    if named is
        if cmd == "doctor" is
            rc = cmd_misc::doctor()
        else if cmd == "info" is
            rc = cmd_misc::info(o)
        else if cmd == "get" is
            rc = guess("", o)
        else is
            rc = guess(cmd, o)
        end
    else if looks_like_link(cmd) is
        rc = guess("", o)
    else is
        ui::fail("Nieznana komenda '" + cmd + "'.")
        let s: string = suggest(cmd)
        if s != "" is ui::hint("Czy chodziło o 'getit " + s + "'?") end
        ui::hint("Pomoc: getit --help")
        rc = 2
    end
    if rc != 0 is exit(rc) end
end
