-> name        => "getit"
-> version     => "1.0.0"
-> author      => "HackerOS Team <hackeros068@gmail.com>"
-> description => "Universal download and repository management tool"
-> license     => "Apache-2.0"
-> edition     => "2026"

[[bin]]
-> name => "getit"
-> path => "src/main.h#"

[profile.release]
-> opt-level => "speed"
-> strip     => true
-> lto       => true
