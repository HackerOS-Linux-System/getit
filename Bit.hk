[package]
-> name        => getit
-> version     => 0.5.0
-> description => Universal download and repository management tool
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => BSD-3-Clause
-> lang        => h#

[layout]
-> src => src

[build]
-> link => static

[default-build]
-> profile => release
-> emit    => bin

! getit uses only H# builtins (plus curl/tar/git at run time), so there are no dependencies
[dependencies]

[commands]
-> check
--> run => bit check
--> description => Type-check every module
-> smoke
--> run => sh tests/smoke.sh cache/build/release/getit
--> description => Run the network smoke tests against the release binary
-> install-local
--> run => install -Dm755 cache/build/release/getit /usr/bin/getit
--> description => Install the release binary to /usr/bin

[hooks]
-> pre-build => echo "building getit (static)"
